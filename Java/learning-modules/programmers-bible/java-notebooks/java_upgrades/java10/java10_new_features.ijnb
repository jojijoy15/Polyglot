      "execution_count": 27,
      "outputs": []
    },
    {
      "id": "3f44ed08-36a4-4c94-9e8c-d8baa17c8fc1",
      "cell_type": "code",
      "source": "// NEW in Java 10: Reader.transferTo(Writer)\r\n// Reads all chars from this Reader and writes to the given Writer\r\n// Returns the number of chars transferred\r\n// Analogous to InputStream.transferTo(OutputStream) added in Java 9\r\n\r\ntry (var reader = new FileReader(\"input.txt\");\r\n     var writer = new FileWriter(\"output.txt\")) {\r\n    long chars = reader.transferTo(writer);\r\n    System.out.println(\"Transferred: \" + chars + \" chars\");\r\n}\r\n\r\n// Copy classpath resource to a String\r\ntry (var reader = new InputStreamReader(\r\n         MyClass.class.getResourceAsStream(\"/template.txt\"))) {\r\n    var sw = new StringWriter();\r\n    reader.transferTo(sw);\r\n    String content = sw.toString();\r\n}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "b41c5523-6e67-44cf-81a7-5023ccba3244",
      "cell_type": "code",
      "source": "// Thread.destroy() and Thread.stop(Throwable) — finally deprecated for removal\r\n// (Thread.stop() no-arg was deprecated since Java 1.2)\r\n// Marked @Deprecated(forRemoval=true) in Java 10\r\n\r\n// Use interruption instead:\r\nThread t = new Thread(() -> {\r\n    while (!Thread.currentThread().isInterrupted()) {\r\n        doWork();\r\n    }\r\n});\r\nt.start();\r\nt.interrupt(); // cooperative stopping — preferred over stop()\r\n\r\n// Security Manager deprecated eventually (Java 17 final deprecation)\r\n// Java 10: still active, but usage discouraged in new code\r\n\r\n// finalize() methods on JDK classes deprecated\r\n// (FileInputStream.finalize(), FileOutputStream.finalize(), etc.)\r\n// Use try-with-resources instead of relying on finalizers:\r\ntry (var fis = new FileInputStream(\"file.txt\")) {\r\n    // resource closed automatically — no finalize needed\r\n}",
      "metadata": {
        "language": "java"
      },
