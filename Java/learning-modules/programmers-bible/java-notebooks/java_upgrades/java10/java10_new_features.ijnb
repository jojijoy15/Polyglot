    {
      "id": "f418835c-1195-4d49-910e-471197965a02",
      "cell_type": "code",
      "source": "// var pairs naturally with streams to reduce type noise\r\nvar words = List.of(\"hello\", \"world\", \"java\", \"ten\");\r\n\r\nvar grouped = words.stream()\r\n    .collect(Collectors.groupingBy(String::length));\r\n// Map<Integer, List<String>> — inferred\r\n\r\nvar stats = words.stream()\r\n    .collect(Collectors.summarizingInt(String::length));\r\n// IntSummaryStatistics — inferred\r\n\r\nvar joined = words.stream()\r\n    .collect(Collectors.joining(\", \"));\r\n// String — inferred\r\n\r\n// Avoid var when type is not obvious\r\n// var x = compute(); // ← what is x? Unclear without return type",
      "metadata": {
        "language": "java",
        "id": "f418835c-1195-4d49-910e-471197965a02",
        "executionSummary": {
          "executionOrder": 27,
          "success": true
        }
