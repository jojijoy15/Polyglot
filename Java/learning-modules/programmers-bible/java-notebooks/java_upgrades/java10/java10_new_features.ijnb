    {
      "id": "7ab1859c-dc99-4bda-b977-e5065ebe558b",
      "cell_type": "code",
      "source": "// var can infer an anonymous class type — impossible with explicit types\r\n// This gives access to the anonymous class's extra methods!\r\nvar obj = new Object() {\r\n    String name = \"anonymous\";\r\n    int value    = 42;\r\n    String describe() { return name + \"=\" + value; }\r\n};\r\nSystem.out.println(obj.name);       // \"anonymous\" — accessible!\r\nSystem.out.println(obj.describe()); // \"anonymous=42\"\r\n// With Object obj = new Object(){...} the extra members are inaccessible\r\n\r\n// Useful for local record-like tuples without a class\r\nvar result = new Object() {\r\n    final int    count    = getCount();\r\n    final double average  = getAverage();\r\n\r\n    public int getCount() { return 100; }\r\n    public double getAverage() { return 75.5; }\r\n};\r\nSystem.out.printf(\"count=%d avg=%.2f%n\", result.count, result.average);",
      "metadata": {
        "language": "java",
        "id": "7ab1859c-dc99-4bda-b977-e5065ebe558b",
        "executionSummary": {
          "executionOrder": 11,
          "success": true
        }
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "anonymous\r\nanonymous=42\r\ncount=100 avg=75.50\r\n"
          },
          "metadata": {},
          "execution_count": 11
        }
      ]
    },
    {
      "id": "eb2f9514-b935-49c5-af05-cdaf3878e0e9",
      "cell_type": "code",
      "source": "// Not allowed in these contexts:\r\n\r\n\r\n// ✗ 1. Cannot be used for fields\r\nclass Foo {\r\n    // var x = 10;  ← compile error — only local variables\r\n}\r\n\r\n// ✗ 2. Cannot be used for method parameters\r\n// void process(var input) { }  ← compile error\r\n\r\n// ✗ 3. Cannot be used for return types\r\n// var getValue() { return 42; }  ← compile error\r\n\r\n// ✗ 4. Cannot be initialised to null (type is unknown)\r\n// var x = null;  ← compile error\r\n\r\n// ✗ 5. Cannot be used without initialiser\r\n// var x;  ← compile error\r\n\r\n// ✗ 6. Cannot be used with array initialiser shorthand\r\n// var arr = {1, 2, 3};  ← compile error (use new int[]{1,2,3})\r\n\r\n// ✗ 7. Cannot be used in lambda (parameter types)\r\n// var fn = (var x) -> x * 2;  ← error in Java 10 (allowed in Java 11)\r\n\r\n// ✗ 8. Cannot be used in catch variable\r\n// try {} catch (var e) {}  ← error in Java 10 (allowed in Java 11? No, still not)\r\n\r\n// ✓ var is a reserved TYPE NAME, not a keyword\r\n// So this is still valid (though confusing):\r\nint var = 10;      // var as variable name — legal but discouraged\r\nvoid var() {}      // var as method name — legal but discouraged",
      "metadata": {
        "language": "java",
        "id": "eb2f9514-b935-49c5-af05-cdaf3878e0e9",
        "executionSummary": {
          "executionOrder": 12,
