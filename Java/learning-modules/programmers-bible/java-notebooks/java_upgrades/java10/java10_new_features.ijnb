    {
      "id": "75c429e9-df3f-4853-92c4-ae64bec252af",
      "cell_type": "code",
      "source": "import java.util.Map;\r\nimport java.util.List;\r\nimport java.util.Optional;\r\nimport java.util.stream.Stream;\r\nimport java.util.stream.Collectors;\r\nimport java.net.http.HttpRequest;\r\nimport java.net.URI;\r\nimport java.io.FileInputStream;\r\nimport java.io.FileOutputStream;\r\n\r\n// Reduces boilerplate with complex generic types\r\n// Before:\r\nMap<String, Map<Integer, List<String>>> nested =\r\n    new HashMap<String, Map<Integer, List<String>>>();\r\n\r\n// After:\r\nvar nested = new HashMap<String, Map<Integer, List<String>>>();\r\n\r\n// Works well with streams — infers intermediate types\r\nvar grouped = Stream.of(\"apple\", \"ant\", \"bat\", \"bee\")\r\n    .collect(Collectors.groupingBy(s -> s.charAt(0)));\r\n// Map<Character, List<String>> — inferred automatically\r\n\r\n// Optional — infers full Optional type\r\nvar opt = Optional.of(\"hello\"); // Optional<String>\r\nvar val = opt.map(String::toUpperCase).orElse(\"default\");\r\n\r\n// Useful when RHS is verbose (Builder pattern)\r\nvar request = HttpRequest.newBuilder()\r\n    .uri(URI.create(\"https://api.example.com\"))\r\n    .GET()\r\n    .build(); // HttpRequest — no need to repeat type\r\n\r\n// Good practice: use var when the type is obvious from context\r\n// var users = userRepository.findAll();   // obvious from method name\r\n// var count = users.size();               // obviously int\r\n// Avoid when type is not obvious without the RHS:\r\n// var x = process();  ← what type is this?  Better to be explicit.",
      "metadata": {
        "language": "java",
        "id": "75c429e9-df3f-4853-92c4-ae64bec252af",
        "executionSummary": {
          "executionOrder": 28,
          "success": true
        }
      },
      "execution_count": 28,
      "outputs": []
    },
    {
      "id": "a7f7fb13-4528-45e2-933b-18b906e33503",
      "cell_type": "code",
      "source": "// var infers the STATIC compile-time type — not runtime type\r\n\r\nimport java.lang.Integer;\r\nimport java.lang.Number;\r\n\r\nNumber n = Integer.valueOf(42);   // explicit — type is Number\r\nvar v = Integer.valueOf(42);   // var — type is Integer (more specific)\r\n\r\n// Ternary expressions: var infers the common supertype\r\nboolean condition = true;\r\nvar x = condition ? \"hello\" : \"world\"; // String\r\nvar y = condition ? 1 : 2.0;            // double (widened)\r\nvar z = condition ? 1 : \"str\";          // Serializable & Comparable (common)\r\n\r\n// Once inferred, type is FIXED — this fails:\r\nvar name = \"Alice\"; // String\r\n// name = 42;  ← compile error — cannot assign int to String",
      "metadata": {
        "language": "java",
        "id": "a7f7fb13-4528-45e2-933b-18b906e33503",
        "executionSummary": {
          "executionOrder": 20,
          "success": true
        }
      },
      "execution_count": 20,
      "outputs": []
    },
    {
      "id": "0928826a-e936-434b-8a24-6ae2051335a6",
      "cell_type": "markdown",
      "source": "## Collections API changes",
      "metadata": {
        "language": "markdown",
        "id": "0928826a-e936-434b-8a24-6ae2051335a6"
      }
    },
    {
      "id": "3b3cb9dd-182c-400f-9c0b-a6b942cd0033",
      "cell_type": "code",
      "source": "// Create unmodifiable copies of any collection\r\nList<String> mutable = new ArrayList<>(Arrays.asList(\"a\", \"b\", \"c\"));\r\nList<String> immutable = List.copyOf(mutable);\r\n\r\n// immutable.add(\"d\");    ← UnsupportedOperationException\r\n// immutable.remove(\"a\"); ← UnsupportedOperationException\r\n// immutable.set(0,\"x\");  ← UnsupportedOperationException\r\n\r\n// Changes to original do NOT affect the copy\r\nmutable.add(\"d\");\r\nSystem.out.println(immutable); // [a, b, c] — unaffected\r\n\r\n// Set.copyOf\r\nSet<Integer> mutableSet = new HashSet<>(Set.of(1,2,3));\r\nSet<Integer> immutableSet = Set.copyOf(mutableSet);\r\n\r\n// Map.copyOf\r\nMap<String, Integer> mutableMap = new HashMap<>();\r\nmutableMap.put(\"a\", 1); mutableMap.put(\"b\", 2);\r\nMap<String, Integer> immutableMap = Map.copyOf(mutableMap);\r\n\r\n// Rules — same as List.of / Set.of / Map.of:\r\n// - Null elements are NOT allowed (NullPointerException if source has null)\r\n// - Duplicate keys in Set/Map source → may throw IllegalArgumentException\r\n// - Iteration order is NOT guaranteed for Set/Map\r\n// - Optimisation: if the source is already an unmodifiable collection\r\n//   of the same type, the JVM MAY return the same instance (no copy)",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "8f8aa666-3035-4348-a7e5-66928adf39cf",
      "cell_type": "code",
      "source": "// New terminal operations that collect directly into unmodifiable collections\r\nList<String> names = List.of(\"Alice\", \"Bob\", \"Carol\", \"Dave\");\r\n\r\n// toUnmodifiableList\r\nList<String> filtered = names.stream()\r\n    .filter(n -> n.length() > 3)\r\n    .collect(Collectors.toUnmodifiableList());\r\n// [Alice, Carol, Dave] — unmodifiable\r\n\r\n// toUnmodifiableSet\r\nSet<Integer> lengths = names.stream()\r\n    .map(String::length)\r\n    .collect(Collectors.toUnmodifiableSet());\r\n// {3, 4, 5} — unmodifiable Set (order not guaranteed)\r\n\r\n// toUnmodifiableMap(keyMapper, valueMapper)\r\nMap<String, Integer> nameLengths = names.stream()\r\n    .collect(Collectors.toUnmodifiableMap(\r\n        n -> n,            // key: the name\r\n        String::length     // value: its length\r\n    ));\r\n// {Alice=5, Bob=3, Carol=5, Dave=4} — unmodifiable\r\n\r\n// toUnmodifiableMap with merge function (for duplicate keys)\r\nMap<Integer, String> byLength = names.stream()\r\n    .collect(Collectors.toUnmodifiableMap(\r\n        String::length,\r\n        n -> n,\r\n        (a, b) -> a + \",\" + b  // merge duplicates\r\n    ));\r\n// {3=Bob, 4=Dave, 5=Alice,Carol}\r\n\r\n// Comparison: old vs new\r\n// Old Java 8 way:\r\nCollections.unmodifiableList(\r\n    names.stream().filter(n->n.length()>3).collect(Collectors.toList()));\r\n// New Java 10 way:\r\nnames.stream().filter(n->n.length()>3).collect(Collectors.toUnmodifiableList());",
      "metadata": {
        "language": "java",
        "id": "8f8aa666-3035-4348-a7e5-66928adf39cf",
        "executionSummary": {
          "executionOrder": 29,
          "success": true
        }
      },
      "execution_count": 29,
      "outputs": []
    },
    {
      "id": "a8ae72fb-fdd3-438e-b371-021d1537fce5",
      "cell_type": "markdown",
      "source": "## Optional API changes",
      "metadata": {
        "language": "markdown",
        "id": "a8ae72fb-fdd3-438e-b371-021d1537fce5"
      }
    },
    {
      "id": "2a387524-6fea-4c0e-be27-5967366a2898",
      "cell_type": "code",
      "source": "Optional<String> present = Optional.of(\"Alice\");\r\nOptional<String> empty   = Optional.empty();\r\n\r\n// New no-arg orElseThrow() — preferred over get()\r\nString val1 = present.orElseThrow(); // \"Alice\"\r\n// empty.orElseThrow();  ← throws NoSuchElementException\r\n\r\n// Compare the three ways to \"get or throw\":\r\npresent.get();           // Java 8 — ambiguous intent, get() sounds safe\r\npresent.orElseThrow();   // Java 10 — explicitly states: throw if empty ✓\r\npresent.orElseThrow(() -> new RuntimeException(\"not found\")); // Java 8 custom\r\n\r\n// Works on OptionalInt, OptionalLong, OptionalDouble too\r\nOptionalInt    oi = OptionalInt.of(42);\r\nOptionalLong   ol = OptionalLong.of(100L);\r\nOptionalDouble od = OptionalDouble.of(3.14);\r\n\r\nint    i = oi.orElseThrow(); // 42\r\nlong   l = ol.orElseThrow(); // 100\r\ndouble d = od.orElseThrow(); // 3.14\r\n\r\n// Practical usage pattern\r\nUser user = userRepository.findById(id)\r\n    .orElseThrow(); // clear: \"this MUST be present, or fail\"\r\n\r\n// vs get() which looks like it might safely return null or similar",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "f1d1d08a-0460-4d25-9cf7-bd7b9c46d1d2",
      "cell_type": "code",
      "source": "// Java 14 formally deprecated Optional.get() in favour of orElseThrow()\r\n// (The deprecation happened in Java 14, but the replacement is Java 10)\r\n// The intent of the author is clearer with orElseThrow():\r\n\r\n// get() looks innocent — like accessing a field\r\nString s1 = opt.get(); // could surprise you if opt is empty\r\n\r\n// orElseThrow() is explicit — reader knows it will throw on empty\r\nString s2 = opt.orElseThrow(); // intent is clear\r\n\r\n// In an IDE, orElseThrow() shows up in autocomplete as a valid\r\n// terminal operation alongside orElse/orElseGet, making the API\r\n// more discoverable and consistent.\r\n\r\n// Recommended migration:\r\n// opt.get()  →  opt.orElseThrow()",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "cd5b76cc-7ed6-4c13-8375-a089db295ea7",
      "cell_type": "markdown",
      "source": "## Collectors API changes\r\n\r\n_(Nothing new in streams)_",
      "metadata": {
        "language": "markdown",
        "id": "cd5b76cc-7ed6-4c13-8375-a089db295ea7"
      }
    },
    {
      "id": "d20faf46-8c26-4d43-bbf0-896dba4f5279",
      "cell_type": "code",
      "source": "// Full reference with all signatures\r\n\r\nimport java.util.stream.*;\r\n\r\n// 1. Collectors.toUnmodifiableList()\r\n// static <T> Collector<T, ?, List<T>> toUnmodifiableList();\r\n\r\n// 2. Collectors.toUnmodifiableSet()\r\n// static <T> Collector<T, ?, Set<T>> toUnmodifiableSet();\r\n\r\n// 3a. Collectors.toUnmodifiableMap(keyMapper, valueMapper)\r\n// static <T,K,U> Collector<T,?,Map<K,U>>\r\n//     toUnmodifiableMap(Function<? super T,? extends K> keyMapper,\r\n//                       Function<? super T,? extends U> valueMapper)\r\n\r\n// 3b. With merge function for duplicate keys\r\n// static <T,K,U> Collector<T,?,Map<K,U>>\r\n//     toUnmodifiableMap(Function keyMapper,\r\n//                       Function valueMapper,\r\n//                       BinaryOperator<U> mergeFunction)\r\n\r\n// Example — pipeline to immutable result in one shot\r\nvar result = IntStream.rangeClosed(1, 5)\r\n    .boxed()\r\n    .collect(Collectors.toUnmodifiableList());\r\nSystem.out.println(result);\r\n// [1, 2, 3, 4, 5] — unmodifiable",
      "metadata": {
        "language": "java",
        "id": "d20faf46-8c26-4d43-bbf0-896dba4f5279",
        "executionSummary": {
          "executionOrder": 26,
          "success": true
        }
      },
      "execution_count": 26,
      "outputs": [
        {
          "output_type": "execute_result",
