    {
      "id": "14511795-2e69-4a4e-9400-614ca0021620",
      "cell_type": "markdown",
      "source": "### Text Block",
      "metadata": {
        "language": "markdown",
        "id": "14511795-2e69-4a4e-9400-614ca0021620"
      }
    },
    {
      "id": "0ddec585-aa1e-402c-8a36-3c2bf05ec28c",
      "cell_type": "code",
      "source": "// Before Java 15 — escape-heavy string concatenation\r\nString html = \"<html>\\n\" +\r\n              \"  <body>\\n\" +\r\n              \"    <p>Hello</p>\\n\" +\r\n              \"  </body>\\n\" +\r\n              \"</html>\";\r\n\r\n// Java 15 — permanent text block syntax\r\nString html = \"\"\"\r\n        <html>\r\n          <body>\r\n            <p>Hello</p>\r\n          </body>\r\n        </html>\r\n        \"\"\";\r\n// Incidental leading whitespace is stripped to the\r\n// column of the least-indented content line.\r\n\r\n// \\<line-terminator> — suppress the newline (join lines)\r\nString s = \"\"\"\r\n        Hello, \\\r\n        World!\r\n        \"\"\";\r\n// Result: \"Hello, World!\\n\"\r\n\r\n// \\s — explicit trailing space (prevents auto-trim)\r\nString padded = \"\"\"\r\n        red  \\s\r\n        green\\s\r\n        blue \\s\r\n        \"\"\";\r\n// Each line has exactly one preserved trailing space\r\n\r\n// String::formatted() works inline\r\nString page = \"\"\"\r\n        <!DOCTYPE html>\r\n        <html>\r\n          <head><title>%s</title></head>\r\n          <body><p>Welcome, %s!</p></body>\r\n        </html>\r\n        \"\"\".formatted(\"My Site\", \"Alice\");\r\n\r\n// SQL query\r\nString query = \"\"\"\r\n        SELECT id, name, salary\r\n        FROM   employees\r\n        WHERE  dept   = 'Engineering'\r\n          AND  active = true\r\n        ORDER  BY salary DESC\r\n        \"\"\";",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "faaea451-bc94-44d1-b307-756d7384e848",
      "cell_type": "markdown",
      "source": "### Records",
      "metadata": {
        "language": "markdown",
        "id": "faaea451-bc94-44d1-b307-756d7384e848"
      }
    },
    {
      "id": "efab0449-7afc-442b-824c-91bd860ed46c",
      "cell_type": "code",
      "source": "// Records can now be declared inside a method\r\nList<Order> orders = fetchOrders();\r\n\r\n// Local record — visible only in this method\r\nrecord OrderSummary(String id, double total) {}\r\n\r\nList<OrderSummary> summaries = orders.stream()\r\n    .map(o -> new OrderSummary(o.id(), o.subtotal() * 1.1))\r\n    .sorted(Comparator.comparingDouble(OrderSummary::total))\r\n    .toList();\r\n\r\nsummaries.forEach(System.out::println);",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "72c917d1-5514-4937-a2f7-484a7028c70c",
      "cell_type": "code",
      "source": "// Generic record\r\nrecord Pair<A, B>(A first, B second) {\r\n    // Compact canonical constructor for validation\r\n    Pair {\r\n        Objects.requireNonNull(first,  \"first must not be null\");\r\n        Objects.requireNonNull(second, \"second must not be null\");\r\n    }\r\n    // Custom method\r\n    Pair<B, A> swapped() { return new Pair<>(second, first); }\r\n}\r\n\r\nvar pair = new Pair<>(\"hello\", 42);\r\nSystem.out.println(pair.first());      // hello\r\nSystem.out.println(pair.swapped());    // Pair[first=42, second=hello]",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "2721b088-6c2b-42c5-8c82-669bc422df48",
      "cell_type": "markdown",
      "source": "### Sealed classes",
      "metadata": {
        "language": "markdown",
        "id": "2721b088-6c2b-42c5-8c82-669bc422df48"
      }
    },
    {
      "id": "182f2cb8-a8dd-4613-b3a5-29f0dcb67a8a",
      "cell_type": "code",
      "source": "// Sealed interface — only these three types may implement it\r\npublic sealed interface Shape\r\n    permits Circle, Rectangle, Triangle {}\r\n\r\n// Each permitted subtype must be:\r\n//   final        — no further extension\r\n//   sealed       — further restricted hierarchy\r\n//   non-sealed   — open to any extension\r\npublic final class Circle    implements Shape {\r\n    double radius() { return radius; }\r\n    private final double radius;\r\n    Circle(double r) { this.radius = r; }\r\n}\r\n\r\npublic final class Rectangle implements Shape {\r\n    double width() { return w; } double height() { return h; }\r\n    private final double w, h;\r\n    Rectangle(double w, double h) { this.w = w; this.h = h; }\r\n}\r\n\r\npublic non-sealed class Triangle implements Shape {\r\n    // Any class can extend Triangle\r\n}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "b6c59b37-2538-4064-a0df-ebb3b8033186",
      "cell_type": "code",
      "source": "// Works with switch expressions for exhaustive checks\r\n// (full exhaustiveness enforcement arrives with pattern\r\n//  matching for switch in Java 17+, but the hierarchy\r\n//  is already useful for instanceof chains)\r\ndouble area(Shape s) {\r\n    if (s instanceof Circle c) {\r\n        return Math.PI * c.radius() * c.radius();\r\n    } else if (s instanceof Rectangle r) {\r\n        return r.width() * r.height();\r\n    } else if (s instanceof Triangle t) {\r\n        return computeTriangleArea(t);\r\n    }\r\n    // Compiler knows Shape is sealed — no unknown subtypes\r\n    throw new AssertionError(\"Unreachable\");\r\n}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "2727bf2b-9be0-4948-b078-75d179eb6252",
      "cell_type": "code",
      "source": "// All permitted types must be in the same package\r\n// (or same compilation unit for unnamed packages)\r\n\r\n// Shape.java\r\npackage com.example.shapes;\r\npublic sealed interface Shape\r\n    permits Circle, Rectangle {}   // in same package\r\n\r\n// Circle.java\r\npackage com.example.shapes;\r\npublic final class Circle implements Shape { ... }\r\n\r\n// Compile with preview enabled\r\n// javac --enable-preview --release 15 *.java\r\n// java  --enable-preview com.example.Main",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "6735bbf4-7f26-4fc5-b1ab-10699aadd12b",
      "cell_type": "markdown",
      "source": "### Pattern Matching",
      "metadata": {
        "language": "markdown",
        "id": "6735bbf4-7f26-4fc5-b1ab-10699aadd12b"
      }
    },
    {
      "id": "cd9403ed-f431-43c8-b3d8-55706777cf0b",
      "cell_type": "code",
      "source": "// Before — manual cast\r\nif (obj instanceof String) {\r\n    String s = (String) obj;\r\n    System.out.println(s.toUpperCase());\r\n}\r\n\r\n// Java 15 — pattern variable bound automatically\r\nif (obj instanceof String s) {\r\n    System.out.println(s.toUpperCase());\r\n}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "7409ac19-2e98-467d-970f-9c00dfeb83a8",
      "cell_type": "code",
      "source": "// Pattern variable can be used in the same condition\r\nif (obj instanceof String s && s.length() > 5) {\r\n    System.out.println(\"Long string: \" + s);\r\n}\r\n\r\n// Negation — s scoped after the block\r\nif (!(obj instanceof String s)) {\r\n    throw new IllegalArgumentException(\"Not a string\");\r\n}\r\n// s is in scope here\r\nSystem.out.println(s.trim());\r\n\r\n// javac --enable-preview --release 15 MyClass.java\r\n// java  --enable-preview MyClass",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "efbe1c23-120b-475e-863f-5c5d9e8812fb",
      "cell_type": "markdown",
      "source": "###  Platform Changes\r\n\r\n#### Encryption",
      "metadata": {
        "language": "markdown",
        "id": "efbe1c23-120b-475e-863f-5c5d9e8812fb"
      }
    },
    {
      "id": "37d757ac-118e-487b-adad-925538b7c944",
      "cell_type": "code",
      "source": "import java.security.*;\r\n\r\n/*\r\n Key Generation & signing with EdDSA\r\n*/\r\n// Generate an Ed25519 key pair\r\nKeyPairGenerator kpg = KeyPairGenerator.getInstance(\"Ed25519\");\r\nKeyPair kp = kpg.generateKeyPair();\r\n\r\n// Sign data\r\nSignature sig = Signature.getInstance(\"Ed25519\");\r\nsig.initSign(kp.getPrivate());\r\nsig.update(\"Hello, EdDSA!\".getBytes());\r\nbyte[] signature = sig.sign();\r\n\r\n// Verify\r\nsig.initVerify(kp.getPublic());\r\nsig.update(\"Hello, EdDSA!\".getBytes());\r\nboolean valid = sig.verify(signature);\r\nSystem.out.println(\"Valid: \" + valid); // true",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "724e3a91-5d29-4bb7-9cfe-b875d4f01e88",
      "cell_type": "code",
      "source": "import java.security.*;\r\nimport java.security.spec.*;\r\n\r\n// Ed448 — higher security (224-bit security level)\r\nKeyPairGenerator kpg448 = KeyPairGenerator.getInstance(\"Ed448\");\r\nKeyPair kp448 = kpg448.generateKeyPair();\r\n\r\n// NamedParameterSpec gives fine-grained control\r\nKeyPairGenerator kpg = KeyPairGenerator\r\n    .getInstance(\"EdDSA\");\r\nkpg.initialize(NamedParameterSpec.ED25519);\r\nKeyPair kp = kpg.generateKeyPair();\r\n\r\n// Keys are standard JCA — work with existing APIs\r\nbyte[] pubEncoded = kp.getPublic().getEncoded();\r\nSystem.out.println(kp.getPublic().getAlgorithm()); // EdDSA",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "13a56471-2b30-47bf-8030-1a5103f1d8f1",
      "cell_type": "markdown",
      "source": "### Hidden Classes",
      "metadata": {
        "language": "markdown",
        "id": "13a56471-2b30-47bf-8030-1a5103f1d8f1"
      }
    },
    {
      "id": "ad8c8403-a3d1-4509-9204-370d2833ab76",
      "cell_type": "code",
      "source": "import java.lang.invoke.*;\r\nimport java.lang.invoke.MethodHandles.Lookup;\r\n\r\n// Load class bytes (e.g. from a template or code gen)\r\nbyte[] classBytes = generateBytecode(); // your bytecode\r\n\r\n// Define a hidden class — nestmate of the lookup class\r\nLookup lookup = MethodHandles.lookup();\r\nLookup hiddenLookup = lookup.defineHiddenClass(\r\n    classBytes,\r\n    true,             // initialize immediately\r\n    Lookup.ClassOption.NESTMATE  // shares private access\r\n);\r\n\r\nClass<?> hiddenClass = hiddenLookup.lookupClass();\r\n\r\n// Hidden class has a synthetic name like:\r\n//   com.example.MyClass/0x00007f...\r\nSystem.out.println(hiddenClass.getName());\r\n\r\n// Cannot be found by name\r\ntry {\r\n    Class.forName(hiddenClass.getName()); // throws\r\n} catch (ClassNotFoundException e) {\r\n    System.out.println(\"Not discoverable by name\");\r\n}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
