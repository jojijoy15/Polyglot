    {
      "id": "7f2b4ed6-e948-4885-8d33-d400d968f7c0",
      "cell_type": "code",
      "source": "// Before — escape-heavy single-line concatenation\r\nString json = \"{\\n\" +\r\n              \"  \\\"name\\\": \\\"Alice\\\",\\n\" +\r\n              \"  \\\"age\\\": 30\\n\" +\r\n              \"}\";\r\n\r\n// Java 14 text block\r\nString json = \"\"\"\r\n        {\r\n          \"name\": \"Alice\",\r\n          \"age\": 30\r\n        }\r\n        \"\"\";\r\n// Incidental leading whitespace is stripped automatically\r\n\r\n// \\<line-terminator>  — suppress the newline (join lines visually)\r\nString text = \"\"\"\r\n        Hello, \\\r\n        World!\r\n        \"\"\";\r\n// Result: \"Hello, World!\\n\"   (single line)\r\n\r\n// \\s  — explicit trailing space (prevents trimming)\r\nString cols = \"\"\"\r\n        red  \\s\r\n        green\\s\r\n        blue \\s\r\n        \"\"\";\r\n// Each line has exactly one trailing space preserved\r\n\r\n// Inline HTML\r\nString html = \"\"\"\r\n        <html>\r\n            <body>\r\n                <p>Hello, %s!</p>\r\n            </body>\r\n        </html>\r\n        \"\"\".formatted(\"Alice\");\r\n\r\n// SQL query\r\nString query = \"\"\"\r\n        SELECT id, name, salary\r\n        FROM   employees\r\n        WHERE  department = 'Engineering'\r\n          AND  salary > 80000\r\n        ORDER  BY salary DESC\r\n        \"\"\";",
      "metadata": {
        "language": "java"
