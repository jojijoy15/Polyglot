      "id": "6d7a3f7d-ab1a-43bc-8ca1-26393843b771",
      "cell_type": "markdown",
      "source": "### Switch Expresion Finalized",
      "metadata": {
        "language": "markdown",
        "id": "6d7a3f7d-ab1a-43bc-8ca1-26393843b771"
      }
    },
    {
      "id": "e9159da8-bf6f-46bd-88a6-4ee986c52826",
      "cell_type": "code",
      "source": "// Before Java 14 — statement form, error-prone fall-through\r\nint numLetters;\r\nswitch (day) {\r\n    case MONDAY:\r\n    case FRIDAY:\r\n    case SUNDAY:\r\n        numLetters = 6;\r\n        break;\r\n    case TUESDAY:\r\n        numLetters = 7;\r\n        break;\r\n    default:\r\n        throw new IllegalStateException(\"Unknown: \" + day);\r\n}\r\n\r\n// Java 14 — expression form with arrow labels\r\nint numLetters = switch (day) {\r\n    case MONDAY, FRIDAY, SUNDAY -> 6;\r\n    case TUESDAY               -> 7;\r\n    case THURSDAY, SATURDAY    -> 8;\r\n    case WEDNESDAY             -> 9;\r\n    default -> throw new IllegalStateException(\"Unknown: \" + day);\r\n};",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "4da97b9a-092e-42dd-8365-0926f83c4ae6",
      "cell_type": "markdown",
      "source": "### Pattern matching",
      "metadata": {
        "language": "markdown",
        "id": "4da97b9a-092e-42dd-8365-0926f83c4ae6"
      }
    },
    {
      "id": "d69ab5a7-ae08-4672-9afc-bab10ce5f849",
      "cell_type": "code",
      "source": "// Before Java 14 — two-step check + cast\r\nif (obj instanceof String) {\r\n    String s = (String) obj;   // redundant cast\r\n    System.out.println(s.length());\r\n}\r\n\r\n// Java 14 — bind in one expression\r\nif (obj instanceof String s) {\r\n    System.out.println(s.length());  // s is already a String\r\n}\r\n\r\n// Variable is scoped to the 'true' branch only\r\nObject obj = \"Hello\";\r\n\r\nif (obj instanceof String s && s.length() > 3) {\r\n    // s is in scope here\r\n    System.out.println(s.toUpperCase());\r\n}\r\n// s is NOT in scope here\r\n\r\n// Works with negation too\r\nif (!(obj instanceof String s)) {\r\n    throw new IllegalArgumentException(\"Expected String\");\r\n}\r\n// s is in scope past the early return / throw",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "d0c2c691-4cb1-4ba7-871a-cb85356fd619",
      "cell_type": "markdown",
      "source": "### Record",
      "metadata": {
        "language": "markdown",
        "id": "d0c2c691-4cb1-4ba7-871a-cb85356fd619"
      }
    },
    {
      "id": "9472ed93-a87c-4bb6-89fa-9481a8f0f16c",
      "cell_type": "code",
      "source": "// Java 14 record — 1 line\r\nrecord Point(int x, int y) {}\r\n\r\n// Equivalent pre-14 class — ~30 lines\r\nfinal class Point {\r\n    private final int x;\r\n    private final int y;\r\n    Point(int x, int y) { this.x = x; this.y = y; }\r\n    int x() { return x; }\r\n    int y() { return y; }\r\n    @Override public boolean equals(Object o) { ... }\r\n    @Override public int hashCode() { ... }\r\n    @Override public String toString() { ... }\r\n}\r\n\r\n\r\nrecord Range(int lo, int hi) {\r\n\r\n    // Compact canonical constructor — no parameter list needed\r\n    Range {\r\n        if (lo > hi) throw new IllegalArgumentException(lo + \" > \" + hi);\r\n    }\r\n\r\n    // Custom instance method\r\n    int length() { return hi - lo; }\r\n\r\n    // Static factory\r\n    static Range of(int lo, int hi) { return new Range(lo, hi); }\r\n}\r\n\r\n// Usage\r\nvar r = Range.of(1, 10);\r\nSystem.out.println(r.lo());     // 1\r\nSystem.out.println(r.length()); // 9\r\nSystem.out.println(r);          // Range[lo=1, hi=10]\r\n\r\n\r\n// Implementing an interface with a record\r\n\r\ninterface Shape { double area(); }\r\n\r\nrecord Circle(double radius) implements Shape {\r\n    @Override\r\n    public double area() { return Math.PI * radius * radius; }\r\n}\r\n\r\nrecord Rectangle(double w, double h) implements Shape {\r\n    @Override\r\n    public double area() { return w * h; }\r\n}\r\n\r\nShape s = new Circle(5.0);\r\nSystem.out.println(s.area()); // 78.539...",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
