    {
      "id": "3191fc6e-a6a6-44c7-bcee-5818e12456fa",
      "cell_type": "code",
      "source": "// Java 7/8: diamond <> not allowed with anonymous classes\r\n// Had to specify the type explicitly\r\nComparator<String> c = new Comparator<String>() {  // must write String\r\n    public int compare(String a, String b) { return a.compareTo(b); }\r\n};\r\n\r\n// Java 9: diamond works with anonymous classes (type inferred)\r\nComparator<String> c = new Comparator<>() {  // <> infers String\r\n    public int compare(String a, String b) { return a.compareTo(b); }\r\n};\r\n\r\n// More useful with generic anonymous subclasses\r\nHandler<Request, Response> h = new Handler<>() {\r\n    public Response handle(Request req) { return process(req); }\r\n};",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "cdee7cf8-1bfe-4119-a42d-e3a738dcefa4",
