          "output_type": "execute_result",
          "data": {
            "text/plain": "Fast\r\n"
          },
          "metadata": {},
          "execution_count": 19
        }
      ]
    },
    {
      "id": "1b9bd493-f06e-4fd9-babd-372547f58572",
      "cell_type": "code",
      "source": "\r\n// ===================== 9. Error Handling =====================\r\n\r\n/**\r\n * exceptionally — recovers from an exception by providing a fallback value.\r\n * Only invoked if the previous stage completed exceptionally.\r\n */\r\npublic CompletableFuture<String> exceptionallyExample(boolean shouldFail) {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> {\r\n                if (shouldFail) throw new RuntimeException(\"Boom!\");\r\n                return \"Success\";\r\n            })\r\n            .exceptionally(ex -> \"Recovered from: \" + ex.getMessage())\r\n            .thenApply(String::toUpperCase);\r\n        \r\n}\r\n\r\nexceptionallyExample(true).thenAccept(System.out::println).join();  // Output: Recovered from: Boom!\r\nexceptionallyExample(false).thenAccept(System.out::println).join(); // Output: Success\r\n",
      "metadata": {
        "language": "java",
        "id": "1b9bd493-f06e-4fd9-babd-372547f58572",
        "executionSummary": {
          "executionOrder": 21,
          "success": true
        }
      },
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "RECOVERED FROM: JAVA.LANG.RUNTIMEEXCEPTION: BOOM!\r\nSUCCESS\r\n"
          },
          "metadata": {},
          "execution_count": 21
        }
      ]
    },
    {
      "id": "05f9ff98-83c7-4868-a646-b5f74d615072",
      "cell_type": "code",
      "source": "\r\n/**\r\n * handle — processes BOTH success and failure in a single callback.\r\n * Always invoked regardless of whether the previous stage succeeded or failed.\r\n * <p>\r\n * Difference from exceptionally:\r\n * - exceptionally: only called on failure, receives Throwable\r\n * - handle: always called, receives (result, exception) — one will be null\r\n */\r\npublic CompletableFuture<String> handleExample(boolean shouldFail) {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> {\r\n                if (shouldFail) throw new RuntimeException(\"Oops!\");\r\n                return \"OK\";\r\n            })\r\n            .handle((result, ex) -> {\r\n                if (ex != null) {\r\n                    return \"Handled error: \" + ex.getMessage();\r\n                }\r\n                return \"Handled success: \" + result;\r\n            });\r\n}\r\n\r\nhandleExample(true).thenAccept(System.out::println).join();  // Output: Handled error: Oops!\r\nhandleExample(false).thenAccept(System.out::println).join(); // Output: Handled success\r\n",
      "metadata": {
        "language": "java",
        "id": "05f9ff98-83c7-4868-a646-b5f74d615072",
        "executionSummary": {
          "executionOrder": 22,
          "success": true
        }
      },
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Handled error: java.lang.RuntimeException: Oops!\r\nHandled success: OK\r\n"
          },
          "metadata": {},
          "execution_count": 22
        }
      ]
    },
    {
      "id": "e9898c85-6113-4f9e-9de5-5bef8cd010cb",
      "cell_type": "code",
      "source": "\r\n/**\r\n * whenComplete — like handle, but does NOT transform the result.\r\n * Used for side-effects (logging, metrics) without changing the pipeline value.\r\n * If the original future failed, it stays failed after whenComplete.\r\n */\r\n\r\npublic CompletableFuture<String> whenCompleteExample() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> { return \"data\"; })\r\n            //.<String>supplyAsync(() -> { throw new RuntimeException(\"Error in supplyAsync\"); })\r\n            .whenComplete((result, ex) -> {\r\n                if (ex != null) {\r\n                    System.out.println(\"Logging error: \" + ex.getMessage());\r\n                } else {\r\n                    System.out.println(\"Logging result: \" + result);\r\n                }\r\n            });\r\n}\r\n\r\nwhenCompleteExample().thenAccept(System.out::println); // Output: Logging result: data",
      "metadata": {
        "language": "java",
        "id": "e9898c85-6113-4f9e-9de5-5bef8cd010cb",
        "executionSummary": {
          "executionOrder": 23,
          "success": true
        }
      },
      "execution_count": 23,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Logging result: data\r\ndata\r\n"
          },
          "metadata": {},
          "execution_count": 23
        }
      ]
    },
    {
      "id": "8a2ae510-8381-473e-ae56-98720c8f7632",
      "cell_type": "code",
      "source": "\r\n// ===================== 11. Chaining multiple stages — real-world pipeline =====================\r\n\r\n/**\r\n * A realistic pipeline combining multiple operations:\r\n * <pre>\r\n * fetchOrderId()                          → supplyAsync\r\n *   .thenCompose(fetchOrderDetails)       → async DB lookup (flatMap)\r\n *   .thenCombine(fetchExchangeRate)       → parallel lookup, combine\r\n *   .thenApply(formatResult)              → transform\r\n *   .exceptionally(fallback)              → error recovery\r\n * </pre>\r\n */\r\n\r\nimport java.util.concurrent.CompletableFuture;\r\n\r\npublic CompletableFuture<String> realisticPipeline() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> {\r\n                sleep(50);\r\n                throw new RuntimeException(\"Step 1:Failed to fetch order ID\"); // Simulate failure\r\n                // return 1001;    // Step 1: get order ID\r\n            })\r\n            .exceptionally(ex -> {\r\n                System.out.println(\"Pipeline failed during order ID fetch: \" + ex.getMessage());\r\n                return \"-1\"; // fallback order ID\r\n            })\r\n            .thenCompose(orderId -> CompletableFuture.supplyAsync(() -> {\r\n                sleep(50);\r\n                System.out.println(\"Step 2: Fetched order ID \" + orderId);\r\n                throw new RuntimeException(\"Step 2:Failed to fetch order details\"); // Simulate failure\r\n                // return \"Order#\" + orderId + \" total=$100\";   // Step 2: fetch order details\r\n            }))\r\n            .exceptionally(ex -> \"Pipeline failed during order details fetch: \" + ex.getMessage()) // Handle exceptions from compose\r\n            .thenCombine(\r\n                    CompletableFuture.supplyAsync(() -> {\r\n                        sleep(30);\r\n                        return 0.85;                          // Step 3: fetch USD→EUR rate\r\n                    }),\r\n                    (orderDetails, rate) -> orderDetails + \" (EUR: €\" + (100 * rate) + \")\"   // Step 4: combine\r\n            )\r\n            .exceptionally(ex -> \"Pipeline failed during processing: \" + ex.getMessage()) // Handle any exceptions from compose/combine\r\n            .thenApply(String::toUpperCase)                   // Step 5: format\r\n            .exceptionally(ex -> \"Pipeline failed: \" + ex.getMessage());  // Step 6: fallback\r\n}\r\n\r\nSystem.out.print(realisticPipeline().get()); // Output: ORDER#1001 TOTAL=$100 (EUR: €85.0)\r\n",
      "metadata": {
        "language": "java",
        "id": "8a2ae510-8381-473e-ae56-98720c8f7632",
