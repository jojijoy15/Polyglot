          "data": {
            "text/plain": "[A, B, C]\r\n"
          },
          "metadata": {},
          "execution_count": 18
        }
      ]
    },
    {
      "id": "0274d1f3-ff4f-4468-bf4e-299988afec11",
      "cell_type": "code",
      "source": "\r\n// ===================== 8. anyOf — Wait for the FIRST future to complete =====================\r\n\r\n/**\r\n * anyOf returns CompletableFuture&lt;Object&gt; that completes as soon as ANY supplied future completes.\r\n * The result is the value of the first future to finish.\r\n */\r\npublic CompletableFuture<Object> anyOfExample() {\r\n    CompletableFuture<String> f1 = CompletableFuture.supplyAsync(() -> { sleep(200); return \"Slow\"; });\r\n    CompletableFuture<String> f2 = CompletableFuture.supplyAsync(() -> { sleep(50);  return \"Fast\"; });\r\n    CompletableFuture<String> f3 = CompletableFuture.supplyAsync(() -> { sleep(150); return \"Medium\"; });\r\n\r\n    return CompletableFuture.anyOf(f1, f2, f3);\r\n}\r\n\r\nSystem.out.println(anyOfExample().get()); // Output: Fast (the first to complete)\r\n",
      "metadata": {
        "language": "java",
        "id": "0274d1f3-ff4f-4468-bf4e-299988afec11",
        "executionSummary": {
          "executionOrder": 19,
