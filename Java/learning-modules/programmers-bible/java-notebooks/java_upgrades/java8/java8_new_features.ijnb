      "id": "6a85299c-e5c3-4049-95e2-ff3d2b4eabf1",
      "cell_type": "code",
      "source": "//Method Refernce\r\nimport java.util.function.Predicate;\r\n\r\npublic <T> void checkCriteria(T input, Predicate<T> criteria) {\r\n    if (criteria.test(input)) {\r\n        System.out.println(\"Criteria met for \" + input);\r\n    } else {\r\n        System.out.println(\"Criteria not met for \" + input);\r\n    }\r\n}\r\n\r\n\r\ncheckCriteria(5, n -> n > 3); // Output: Criteria met for 5\r\ncheckCriteria(\"Hello\", String::isEmpty); // Output: Is String empty?\r\n\r\nList<String> names = List.of(\"Alice\", \"Bob\", \"Charlie\");\r\n\r\n\r\nSystem.out.println(\"Names sorted by length:\");\r\n\r\nnames.stream()\r\n     .sorted(Comparator.comparingInt(String::length))\r\n     .forEach(System.out::println); // Output: Bob, Alice, Charlie\r\n\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "5600696f-ccba-4a0e-942c-886ab30545ba",
      "cell_type": "code",
      "source": "// Default Methods in Interfaces\r\n\r\n//Inital version of contract\r\ninterface Fan {\r\n\r\n    void turnOn();\r\n\r\n    void turnOff();\r\n\r\n    void setSpeed(int speed);\r\n\r\n    // static void reset() {\r\n    //     this.setSpeed(0);\r\n    //     System.out.println(\"Fan settings reset to default.\");\r\n    // }\r\n\r\n    default void autoMode(int temperature) {\r\n        System.out.println(\"Fan is set to auto mode with temperature \" + temperature);\r\n    }\r\n\r\n}\r\n\r\n//Intial implementation\r\nclass SimpleFan implements Fan {\r\n\r\n    @Override\r\n    public void turnOn() {\r\n        System.out.println(\"Fan is turned on.\");\r\n    }\r\n\r\n    @Override\r\n    public void turnOff() {\r\n        System.out.println(\"Fan is turned off.\");\r\n    }\r\n\r\n    @Override\r\n    public void setSpeed(int speed) {\r\n        System.out.println(\"Fan speed set to \" + speed);\r\n    }\r\n}\r\n\r\n// Fan interface evolve\r\n\r\nFan f = new SimpleFan();\r\nf.turnOn();\r\nf.turnOff();\r\nf.setSpeed(3);\r\n\r\nf.setSpeed(5); // What if we want to set speed to 5? We need to change the interface and all implementations. This is not ideal.\r\nf.turnOff();\r\nf.autoMode(25); // We can add new functionality without breaking existing implementations. This is the power of default methods.\r\n\r\n\r\n    ",
      "metadata": {
        "language": "java",
        "id": "5600696f-ccba-4a0e-942c-886ab30545ba",
        "executionSummary": {
          "executionOrder": 7,
          "success": true
        }
      },
      "execution_count": 7,
