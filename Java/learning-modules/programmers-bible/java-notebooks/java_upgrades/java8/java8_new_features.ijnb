    {
      "id": "037a47a1-a30c-4750-b7de-9b68784650ac",
      "cell_type": "code",
      "source": "import java.lang.annotation.*;\r\n\r\n@Repeatable(Roles.class) //Added in java 8 to allow multiple @Role annotations on the same element\r\n@Target(ElementType.TYPE)\r\n@interface Role {\r\n    String value();\r\n}\r\n\r\n@Target(ElementType.TYPE)\r\n@interface Roles {\r\n    Role[] value();\r\n}\r\n\r\n@Role(\"ADMIN\")\r\n@Role(\"USER\")\r\nclass AccountService {}\r\n\r\n// @Roles({@Role(\"ADMIN\"), @Role(\"USER\")})",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "6d2360ca-efe6-43ef-997e-ac1ecbbe0281",
      "cell_type": "code",
      "source": "//Spliterator\r\n\r\n\r\n\r\n<T> List<String> mapCharacteristics(Collection<T> collection) {\r\n    return List.of(\"ORDERED: \" + collection.spliterator().hasCharacteristics(Spliterator.ORDERED),\r\n                   \"DISTINCT: \" + collection.spliterator().hasCharacteristics(Spliterator.DISTINCT),\r\n                   \"SORTED: \" + collection.spliterator().hasCharacteristics(Spliterator.SORTED),\r\n                   \"SIZED: \" + collection.spliterator().hasCharacteristics(Spliterator.SIZED),\r\n                   \"NONNULL: \" + collection.spliterator().hasCharacteristics(Spliterator.NONNULL),\r\n                   \"IMMUTABLE: \" + collection.spliterator().hasCharacteristics(Spliterator.IMMUTABLE),\r\n                   \"CONCURRENT: \" + collection.spliterator().hasCharacteristics(Spliterator.CONCURRENT),\r\n                   \"SUBSIZED: \" + collection.spliterator().hasCharacteristics(Spliterator.SUBSIZED));\r\n }\r\n\r\nList<String> list = List.of(\"A\", \"B\", \"C\", \"D\", \"E\");\r\nSystem.out.println(list.spliterator().characteristics());\r\nSystem.out.println(mapCharacteristics(list));\r\n\r\n\r\nSet<String> set = Set.of(\"A\", \"B\", \"C\", \"D\", \"E\");\r\nSystem.out.println(set.spliterator().characteristics());\r\nSystem.out.println(mapCharacteristics(set));\r\n\r\n//List Operations\r\n\r\nSystem.out.println(\"*****[List Operations] Spliterator******\");\r\n\r\nSystem.out.println(\"Bulk Element processing:\");\r\n\r\nlist.spliterator().forEachRemaining(System.out::println); // bulk processing, will throw ConcurrentModificationException if list is modified during processing, after bulk processing, spliterator is exhausted and cannot be used again.\r\n\r\nSystem.out.println(\"Single element processing:\");\r\n\r\nlist.spliterator().tryAdvance(System.out::println); // single element processing\r\n//\r\nSpliterator<String> spliterator = list.spliterator();\r\nSpliterator<String> split = spliterator.trySplit(); // split the spliterator into two parts for parallel processing\r\n\r\nSystem.out.println(\"Original spliterator:\");\r\nspliterator.forEachRemaining(System.out::println); // process remaining elements in the original spliterator\r\n\r\nSystem.out.println(\"Split part:\");\r\nsplit.forEachRemaining(System.out::println); // process elements in the split spliterator",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "2172362d-48bd-4545-a370-20c38740e6c7",
      "cell_type": "markdown",
      "source": "## Completable Future\r\n\r\n| Category      | Methods                                                                 |\r\n|---------------|-------------------------------------------------------------------------|\r\n| Create        | `supplyAsync`, `runAsync`, `completedFuture`                             |\r\n| Transform     | `thenApply`, `thenApplyAsync`                                            |\r\n| Consume       | `thenAccept`, `thenRun`                                                  |\r\n| Compose       | `thenCompose` (flatMap — avoids nested futures)                          |\r\n| Combine       | `thenCombine` (merges two independent futures)                           |\r\n| Either        | `acceptEither`, `applyToEither` (first to complete wins)                 |\r\n| All / Any     | `allOf` (wait for all), `anyOf` (wait for first)                         |\r\n| Error         | `exceptionally`, `handle`, `whenComplete`                                |\r\n| Timeout       | `orTimeout`, `completeOnTimeout` (Java 9+)                               |\r\n\r\n ",
      "metadata": {
        "language": "markdown",
        "id": "2172362d-48bd-4545-a370-20c38740e6c7"
      }
    },
    {
      "id": "e31a12b8-de66-4329-92bb-1ddc34736fa2",
      "cell_type": "code",
      "source": "static void sleep(long millis) {\r\n    try {\r\n        Thread.sleep(millis);\r\n    } catch (InterruptedException e) {\r\n        Thread.currentThread().interrupt();\r\n        throw new RuntimeException(e);\r\n    }\r\n}",
      "metadata": {
        "language": "java",
        "id": "e31a12b8-de66-4329-92bb-1ddc34736fa2",
        "executionSummary": {
          "executionOrder": 1,
          "success": true
        }
      },
      "execution_count": 1,
      "outputs": []
    },
    {
      "id": "7a005142-c204-4b6b-b6db-f179910b25e5",
      "cell_type": "code",
      "source": "// Completeable Future\r\nimport java.util.concurrent.CompletableFuture;\r\nimport java.util.concurrent.TimeUnit;\r\n\r\npublic CompletableFuture<String> supplyAsync() {\r\n    return CompletableFuture.supplyAsync(() -> {\r\n        sleep(100);\r\n        return \"Hello from supplyAsync\";\r\n    });\r\n}\r\n\r\n\r\n\r\nSystem.out.println(supplyAsync().get()); // Output: Hello from supplyAsync",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "8da59f63-8682-4c90-906e-9dae3ac07f9a",
      "cell_type": "code",
      "source": "\r\n/** runAsync — runs a Runnable asynchronously, returns CompletableFuture<Void>. */\r\npublic CompletableFuture<Void> runAsync() {\r\n    return CompletableFuture.runAsync(() -> {\r\n        sleep(100);\r\n        System.out.println(\"Side-effect from runAsync\");\r\n    });\r\n}\r\n\r\nrunAsync().join(); // Output: Side-effect from runAsync\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "505336a0-eba0-4037-a506-0b42bc14e903",
      "cell_type": "code",
      "source": "\r\n/** completedFuture — creates an already-completed future. Useful for testing or default values. */\r\npublic CompletableFuture<String> completedFuture(String value) {\r\n    return CompletableFuture.completedFuture(value);\r\n}\r\ncompletedFuture(\"Already completed\")\r\n.thenAccept(System.out::println); // Output: Already completed\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "0f6227bc-a20b-4935-b371-7fafcaa9ad55",
      "cell_type": "code",
      "source": "\r\n// ===================== 2. thenApply — Transform the result (like map) =====================\r\n\r\n/**\r\n * thenApply chains a Function that transforms the result.\r\n * Stage: supplyAsync(\"hello\") → thenApply(toUpperCase) → \"HELLO\"\r\n *\r\n * Runs on the same thread that completed the previous stage (or the caller if already done).\r\n */\r\npublic CompletableFuture<String> thenApplyExample() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> \"hello\")\r\n            .thenApply(String::toUpperCase)       // \"hello\" → \"HELLO\"\r\n            .thenApply(s -> s + \" WORLD\");        // \"HELLO\" → \"HELLO WORLD\"\r\n}\r\nSystem.out.println(thenApplyExample().get()); // Output: HELLO WORLD\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "e7c0955b-3e25-42bb-9e7c-b4a8977b7a8d",
      "cell_type": "code",
      "source": "\r\n/**\r\n * thenApplyAsync — same as thenApply but the function runs on a different thread\r\n * from the ForkJoinPool (or a custom Executor).\r\n */\r\npublic CompletableFuture<Integer> thenApplyAsyncExample() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> \"12345\")\r\n            .thenApplyAsync(String::length);      // runs on a pool thread\r\n}\r\nSystem.out.println(thenApplyAsyncExample().get()); // Output: 5",
      "metadata": {
        "language": "java",
        "id": "e7c0955b-3e25-42bb-9e7c-b4a8977b7a8d",
        "executionSummary": {
          "executionOrder": 5,
          "success": true
        }
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "5\r\n"
          },
          "metadata": {},
          "execution_count": 5
        }
      ]
    },
    {
      "id": "ea784c9f-e683-4f2d-ad36-282016408495",
      "cell_type": "code",
      "source": "\r\n// ===================== 3. thenAccept / thenRun — Consume the result =====================\r\nimport java.util.concurrent.CompletableFuture;\r\n\r\n/**\r\n * thenAccept — consumes the result (returns Void). Use for side effects like logging.\r\n */\r\npublic CompletableFuture<Void> thenAcceptExample() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> \"result\")\r\n            .thenAccept(result -> System.out.println(\"Got: \" + result));\r\n}\r\nthenAcceptExample().join(); // Output: Got: result\r\n",
      "metadata": {
        "language": "java",
        "id": "ea784c9f-e683-4f2d-ad36-282016408495",
        "executionSummary": {
          "executionOrder": 3,
          "success": true
        }
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Got: result\r\n"
          },
          "metadata": {},
          "execution_count": 3
        }
      ]
    },
    {
      "id": "2a3652fd-6b44-4ee9-bf4e-dd162c9200b3",
      "cell_type": "code",
      "source": "\r\n/**\r\n * thenRun — runs a Runnable after the previous stage completes. Does NOT receive the result.\r\n */\r\npublic CompletableFuture<Void> thenRunExample() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> \"ignored\")\r\n            .thenRun(() -> System.out.println(\"Previous stage done, running cleanup\"));\r\n}\r\n\r\nthenRunExample().join(); // Output: Previous stage done, running cleanup",
      "metadata": {
        "language": "java",
        "id": "2a3652fd-6b44-4ee9-bf4e-dd162c9200b3",
        "executionSummary": {
          "executionOrder": 4,
          "success": true
        }
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Previous stage done, running cleanup\r\n"
          },
          "metadata": {},
          "execution_count": 4
        }
      ]
    },
    {
      "id": "1968b328-0902-4de8-bcc2-95de2a94a1cc",
      "cell_type": "code",
      "source": "\r\n// ===================== 4. thenCompose — Flatten nested futures (like flatMap) =====================\r\n\r\n/**\r\n * thenCompose avoids CompletableFuture<CompletableFuture<T>> nesting.\r\n * <p>\r\n * Without compose: supplyAsync().thenApply(fetchDetails) → CompletableFuture<CompletableFuture<String>>\r\n * With compose:    supplyAsync().thenCompose(fetchDetails) → CompletableFuture<String>\r\n * <p>\r\n * Use case: when the transformation itself returns a CompletableFuture (e.g., another async call).\r\n */\r\n\r\n/** Simulates an async database/service call. */\r\n\r\nimport java.util.concurrent.CompletableFuture;\r\n\r\nprivate CompletableFuture<String> fetchUserName(int userId) {\r\n    return CompletableFuture.supplyAsync(() -> {\r\n        sleep(50);\r\n        return \"User-\" + userId;\r\n    });\r\n}\r\n\r\npublic CompletableFuture<String> thenComposeExample() {\r\n    return CompletableFuture\r\n            .supplyAsync(() -> 42)                           // Stage 1: get user ID\r\n            .thenCompose(userId -> fetchUserName(userId));   // Stage 2: async lookup by ID\r\n}\r\n\r\n\r\nSystem.out.println(thenComposeExample().get()); // Output: User-42\r\n",
      "metadata": {
        "language": "java",
        "id": "1968b328-0902-4de8-bcc2-95de2a94a1cc",
        "executionSummary": {
          "executionOrder": 12,
          "success": true
        }
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "User-42\r\n"
          },
          "metadata": {},
          "execution_count": 12
        }
      ]
    },
    {
      "id": "6a8b901d-6395-48b7-8f46-0795fd82e8f3",
      "cell_type": "code",
      "source": "\r\n// ===================== 5. thenCombine — Merge two independent futures =====================\r\n\r\n/**\r\n * thenCombine runs two independent futures in parallel and combines their results\r\n * when BOTH complete.\r\n * <p>\r\n * Use case: fetch price from service A and discount from service B, then compute final price.\r\n */\r\npublic CompletableFuture<String> thenCombineExample() {\r\n    CompletableFuture<String> future1 = CompletableFuture.supplyAsync(() -> {\r\n        sleep(100);\r\n        return \"Hello\";\r\n    });\r\n\r\n    CompletableFuture<String> future2 = CompletableFuture.supplyAsync(() -> {\r\n        sleep(80);\r\n        return \"World\";\r\n    });\r\n\r\n    // Both run concurrently; combine once both are done\r\n    return future1.thenCombine(future2, (r1, r2) -> r1 + \" \" + r2);\r\n}\r\n\r\nSystem.out.println(thenCombineExample().get()); // Output: Hello World\r\n",
      "metadata": {
        "language": "java",
        "id": "6a8b901d-6395-48b7-8f46-0795fd82e8f3",
        "executionSummary": {
          "executionOrder": 13,
          "success": true
        }
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Hello World\r\n"
          },
          "metadata": {},
          "execution_count": 13
        }
      ]
    },
    {
      "id": "650bfbc5-c96a-415d-8f2b-f0f9bded6253",
      "cell_type": "code",
      "source": "\r\n/**\r\n * Practical example: computing a final price from two independent async lookups.\r\n */\r\npublic CompletableFuture<Double> thenCombinePriceExample() {\r\n    CompletableFuture<Double> priceFuture = CompletableFuture.supplyAsync(() -> {\r\n        sleep(100);\r\n        return 100.0;       // base price from pricing service\r\n    });\r\n\r\n    CompletableFuture<Double> discountFuture = CompletableFuture.supplyAsync(() -> {\r\n        sleep(80);\r\n        return 0.15;        // 15% discount from discount service\r\n    });\r\n\r\n    return priceFuture.thenCombine(discountFuture,\r\n            (price, discount) -> price * (1 - discount));   // 100 * 0.85 = 85.0\r\n}\r\n\r\nSystem.out.println(thenCombinePriceExample().get()); // Output: 85.0\r\n",
      "metadata": {
        "language": "java",
        "id": "650bfbc5-c96a-415d-8f2b-f0f9bded6253",
        "executionSummary": {
          "executionOrder": 14,
          "success": true
        }
      },
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "85.0\r\n"
          },
          "metadata": {},
          "execution_count": 14
        }
      ]
    },
    {
      "id": "19136179-ef4d-45c3-a211-83ec6d69cc21",
      "cell_type": "code",
      "source": "\r\n// ===================== 6. acceptEither / applyToEither — First to complete wins =====================\r\n\r\n/**\r\n * applyToEither — applies the function to whichever future completes first.\r\n * Use case: querying two replicas and using the faster response.\r\n */\r\npublic CompletableFuture<String> applyToEitherExample() {\r\n    CompletableFuture<String> fast = CompletableFuture.supplyAsync(() -> {\r\n        sleep(50);\r\n        return \"fast-server\";\r\n    });\r\n\r\n    CompletableFuture<String> slow = CompletableFuture.supplyAsync(() -> {\r\n        sleep(200);\r\n        return \"slow-server\";\r\n    });\r\n\r\n    return fast.applyToEither(slow, result -> \"Winner: \" + result);\r\n}\r\n\r\napplyToEitherExample().thenAccept(System.out::println).join(); // Output: Winner: fast-server\r\n",
      "metadata": {
        "language": "java",
        "id": "19136179-ef4d-45c3-a211-83ec6d69cc21",
        "executionSummary": {
          "executionOrder": 15,
          "success": true
        }
      },
      "execution_count": 15,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Winner: fast-server\r\n"
          },
          "metadata": {},
          "execution_count": 15
        }
      ]
    },
    {
      "id": "d07413a2-28ba-4e93-8343-0e8d2dceebd8",
      "cell_type": "code",
      "source": "\r\n// ===================== 7. allOf — Wait for ALL futures to complete =====================\r\n\r\n/**\r\n * allOf returns CompletableFuture&lt;Void&gt; that completes when ALL supplied futures complete.\r\n * You then manually collect the results from each future.\r\n * <p>\r\n * Use case: parallel fetching of multiple resources, then aggregating results.\r\n */\r\n\r\nimport java.util.List;\r\nimport java.util.concurrent.CompletableFuture;\r\nimport java.util.stream.Collectors;\r\n\r\npublic CompletableFuture<List<String>> allOfExample() {\r\n    List<CompletableFuture<String>> futures = List.of(\r\n            CompletableFuture.supplyAsync(() -> { sleep(100); return \"A\"; }),\r\n            CompletableFuture.supplyAsync(() -> { sleep(80);  return \"B\"; }),\r\n            CompletableFuture.supplyAsync(() -> { sleep(60);  return \"C\"; })\r\n    );\r\n\r\n    // Wait for all, then collect results\r\n    return CompletableFuture\r\n            .allOf(futures.toArray(new CompletableFuture[0]))\r\n            .thenApply(v -> futures.stream()\r\n                    .map(CompletableFuture::join)   // safe — all are already complete\r\n                    .collect(Collectors.toList()));\r\n}\r\n\r\nSystem.out.println(allOfExample().get()); // Output: [A, B, C]\r\n",
      "metadata": {
        "language": "java",
        "id": "d07413a2-28ba-4e93-8343-0e8d2dceebd8",
        "executionSummary": {
          "executionOrder": 18,
          "success": true
        }
      },
      "execution_count": 18,
      "outputs": [
