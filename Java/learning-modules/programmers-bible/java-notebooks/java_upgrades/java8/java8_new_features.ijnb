    {
      "id": "9c548c1b-4bad-4893-a333-f1ebd93affc0",
      "cell_type": "code",
      "source": "// Streams -> A new way to process collections of data in a functional style.\r\n// It allows us to perform operations like filtering, mapping, and reducing on collections in a more concise and readable way.\r\n\r\nimport java.util.stream.Collectors;\r\n\r\n\r\n// Before Java 8, we used to process collections using loops and temporary lists.\r\nList<String> words = List.of(\"Hello\", \"World\", \"Java\", \"Streams\", \"ace\", \"balance\");\r\n\r\nList<String> upperCasedWords = new ArrayList<>();\r\n//Convert the words to uppercase and collect them into a new list\r\nfor(int i = 0;i < words.size(); ++i){\r\n    String upperCasedWord = words.get(i).toUpperCase();\r\n    upperCasedWords.add(upperCasedWord);\r\n}\r\n\r\nSystem.out.println(upperCasedWords); // Output: [HELLO, WORLD, JAVA, STREAMS]\r\n\r\n//After java 8\r\n\r\n// Using for ecach loop\r\n\r\nSystem.out.println(\"*****Using for-each loop******\");\r\n\r\n// Since Java 5\r\nList<String> forEachUpperCasedWords = new ArrayList<>();\r\n\r\nfor(String word : words){\r\n    String upperCasedWord = word.toUpperCase();\r\n    forEachUpperCasedWords.add(upperCasedWord);\r\n}\r\n\r\nwords.forEach(word -> forEachUpperCasedWords.add(word.toUpperCase())); //side effect in forEach, not recommended\r\nSystem.out.println(forEachUpperCasedWords); // Output: [HELLO, WORLD, JAVA, STREAMS]\r\n\r\n// Using Streams\r\n\r\nSystem.out.println(\"*****[Map & Mutable Reduction] Using Streams******\");\r\n\r\n\r\nList<String> streamUpperCasedWords = words.stream()\r\n     .map(String::toUpperCase)                  // Convert each word to uppercase\r\n     .collect(Collectors.toList());             // Collect the uppercase words into a list\r\nSystem.out.println(streamUpperCasedWords);      // Output: [HELLO, WORLD, JAVA, STREAMS]\r\n\r\n\r\nSystem.out.println(\"*****[Filtering & Mutable Reduction] Atleast 5 Characters Words******\");\r\n\r\nList<String> atleastCharacterWords = words.stream()\r\n     .filter(word -> word.length() >= 5)    // Filter words with length >= 5\r\n     .collect(Collectors.toList());         // Collect the filtered words into a list\r\nSystem.out.println(atleastCharacterWords); // Output: [Hello, World, Streams]\r\n\r\nSystem.out.println(\"*****[Sorting - Stateful] Sort Words by Length******\");\r\n\r\n// Using Streams to find the longest word\r\n\r\nList<String> longestWords = words.stream()\r\n     .collect(Collectors.groupingBy(String::length)) // Group words by their length\r\n     .entrySet().stream()                          // Convert the map to a stream of entries\r\n     .sorted(Map.Entry.<Integer, List<String>>comparingByKey().reversed()) // Sort entries by key (length) in descending order\r\n     .findFirst()                                  // Get the entry with the longest length\r\n     .map(Map.Entry::getValue)                     // Get the list of words with the longest length\r\n     .orElse(List.of());                          // Return an empty list if no words are found\r\n\r\nSystem.out.println(\"Longest words are \" + longestWords); // Output: Longest words are [Streams]\r\n\r\n// Average length of words\r\nSystem.out.println(\"*****[Reduction] Average Length ******\");\r\n\r\n\r\ndouble averageLength = words.stream()\r\n     .mapToInt(String::length)                 // Convert each word to its length\r\n     .average()                                // Calculate the average length\r\n     .orElse(0);                               // Return 0 if the stream is empty\r\n\r\nSystem.out.println(\"Average length of words is \" + averageLength); // Output: Average length of words is 5.166666666666667\r\n\r\n// Mention parallel stream\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "a10a628b-50ab-466c-ba4b-c69e5ade7afb",
      "cell_type": "code",
      "source": "import java.util.function.*;\r\n\r\n// Method Reference Types\r\n\r\nimport java.util.stream.Collectors;\r\n\r\n// 1. Static Method Reference (ClassName::staticMethod)\r\nFunction<String, Integer> parseInt = Integer::parseInt;\r\nSystem.out.println(\"Static: \" + parseInt.apply(\"42\")); // 42\r\n\r\n// 2. Instance Method Reference on a particular object (instance::method)\r\nString greeting = \"Hello, World!\";\r\nSupplier<String> toUpper = greeting::toUpperCase;\r\nSystem.out.println(\"Instance: \" + toUpper.get()); // HELLO, WORLD!\r\n\r\n// 3. Instance Method Reference on an arbitrary object of a type (ClassName::instanceMethod)\r\nFunction<String, String> toLowerCase = String::toLowerCase;\r\nSystem.out.println(\"Class Name Instance: \" + toLowerCase.apply(\"JAVA\")); // java\r\n\r\nBiPredicate<String, String> startsWith = String::startsWith;\r\nSystem.out.println(\"StartsWith: \" + startsWith.test(\"Java\", \"Ja\")); // true\r\n\r\n// 4. Constructor Reference (ClassName::new)\r\nFunction<String, StringBuilder> sbCreator = StringBuilder::new;\r\nStringBuilder sb = sbCreator.apply(\"Built via constructor ref\");\r\nSystem.out.println(\"Constructor: \" + sb);\r\n\r\nSupplier<ArrayList<String>> listFactory = ArrayList::new;\r\nArrayList<String> newList = listFactory.get();\r\nnewList.add(\"Created!\");\r\nSystem.out.println(\"Constructor (no-arg): \" + newList);\r\n\r\n// Practical example combining all types\r\nList<String> items = List.of(\"3\", \"1\", \"4\", \"1\", \"5\");\r\n\r\nList<Integer> parsed = items.stream()\r\n    .map(Integer::parseInt)          // static method ref\r\n    .sorted(Integer::compareTo)      // class name instance method ref\r\n    .collect(Collectors.toList());\r\n\r\nSystem.out.println(\"Combined: \" + parsed); // [1, 1, 3, 4, 5]",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "765364e5-8a1d-41ec-b903-081d0cee4fac",
      "cell_type": "code",
      "source": "// Type inference\r\n\r\n// In Java 7, diamond operator was introduced to simplify the instantiation of generic types. \r\n//However, it had limitations in certain contexts, such as when using the addAll method with collections.\r\n\r\nList<String> stringList = new ArrayList<>(); // diamond operator allows to avoid redundant type specification\r\n\r\n/**Limitation **/\r\n// In Java 7 addAll method will throw error because it cannot infer the type of the collection.Unless specified as below\r\nList<String> stringList = new ArrayList<>();\r\nstringList.add(\"A\");\r\nstringList.addAll(Arrays.<String>asList(\"a\", \"b\", \"c\"));\r\n\r\n//In Java 8, it can infer the type and will work fine.\r\nList<String> stringList = new ArrayList<>();\r\nstringList.add(\"A\");\r\nstringList.addAll(Arrays.asList(\"a\", \"b\", \"c\"));\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "7a3ca025-0149-41b1-a1e6-2595ef19c8d4",
      "cell_type": "code",
      "source": "// Before java 7 annotation's ElementType\r\n\r\nimport java.lang.annotation.*;\r\n\r\n@Target({\r\n    ElementType.TYPE,\r\n    ElementType.METHOD, \r\n    ElementType.FIELD, \r\n    ElementType.PARAMETER, \r\n    ElementType.CONSTRUCTOR, \r\n    ElementType.LOCAL_VARIABLE, \r\n    ElementType.ANNOTATION_TYPE, \r\n    })\r\n@Retention(RetentionPolicy.RUNTIME)\r\n\r\n\r\n\r\npublic @interface BeforeJava8Annotation {\r\n    String value();\r\n}\r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "906b1a00-eed1-49fd-9178-1f876fd4de87",
      "cell_type": "code",
      "source": "@Target(ElementType.PACKAGE) // Available in java 7 as well\r\n@Retention(RetentionPolicy.RUNTIME)\r\n@interface PackageInfo {\r\n    String author();\r\n    String version();\r\n}\r\n\r\n\r\n@PackageInfo(\r\n    author = \"Joji Joy\",\r\n    version = \"1.0\"\r\n)\r\npackage com.example.myapp;\r\n\r\n\r\nPackage pkg = Package.getPackage(\"com.example.myapp\");\r\nPackageInfo info = pkg.getAnnotation(PackageInfo.class);\r\n\r\nSystem.out.println(info.author());\r\nSystem.out.println(info.version());",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "34c67d16-3ce7-45f1-a53c-3b060da44d06",
      "cell_type": "code",
      "source": "// Annotations\r\n\r\n// Before Java 8, we could not use annotations on types.\r\n\r\n\r\n@BeforeJava8Annotation(\"This is a class\") // Type\r\nclass MyClass {\r\n\r\n    @BeforeJava8Annotation(\"This is a field\") // Field\r\n    private String myField;\r\n\r\n    @BeforeJava8Annotation(\"This is a constructor\") //Constructor\r\n    public MyClass() {\r\n    }\r\n\r\n    @BeforeJava8Annotation(\"This is a method\")\r\n    public void myMethod(@BeforeJava8Annotation(\"This is a parameter\") String param) {\r\n        @BeforeJava8Annotation(\"This is a local variable\")\r\n        String localVar = \"Hello\";\r\n        System.out.println(localVar);\r\n    }\r\n}\r\n\r\nMyClass myClass = new MyClass();\r\nmyClass.myMethod(\"Test\");",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "ef72394b-635e-4318-bb33-4d5ffcd999e5",
      "cell_type": "code",
      "source": "// After java 8 annotation's ElementType\r\n\r\nimport java.lang.annotation.*;\r\n\r\n@Target(ElementType.TYPE_USE)\r\n@Retention(RetentionPolicy.RUNTIME)\r\n@interface NonNull {}",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "0d49384f-d0f8-40e8-8d9e-8513371105b0",
      "cell_type": "code",
      "source": "// Variable annotations\r\n\r\n@NonNull String name = \"Joji\";\r\n\r\n// Generic type annotations\r\n\r\nList<@NonNull String> names = new ArrayList<>(); // Useful for static analysis tools to check for nullability of elements in the list\r\n\r\n//Return Types\r\npublic @NonNull String getName() {\r\n    return \"Joji\";\r\n}\r\n\r\n//Casts\r\n\r\nObject obj = null;\r\nString str = (@NonNull String) obj;\r\n\r\nabstract class Printer<T> {\r\n\r\n    List<T> list = new ArrayList<>();\r\n    public abstract void print();\r\n\r\n\r\n    public void add(@NonNull T element) {\r\n        list.add(element);\r\n    }\r\n}\r\n\r\nclass PrettyPrinter extends Printer<@NonNull String> {\r\n\r\n    @Override\r\n    public void print() {\r\n        for(String element : list) {\r\n            System.out.println(\"*\".repeat(2) + element + \"*\".repeat(2));\r\n        }\r\n    }\r\n}\r\n\r\nPrettyPrinter printer = new PrettyPrinter();\r\nprinter.add(\"Hello\");\r\nprinter.print();\r\n\r\n\r\nvoid process() throws @NonNull IOException { //static analyser highlights or flags any place that may lead to throw null ;\r\n    PrettyPrinter printer = new PrettyPrinter();\r\n    printer.add(\"Printer\");\r\n    printer.add(null); // static analyser will flag this as potential null assignment\r\n    printer.print();\r\n} \r\n\r\nprocess();\r\n\r\n@NonNull String[] arr; // arr = null; // static analyser will flag this as potential null assignment\r\nString @NonNull [] arr2; //arr2 = null; // static analyser will flag this as potential null assignmen\r\n\r\n\r\n//ensures matrix[row] is not null, but matrix[row][col] can be null. \r\n// Useful for static analysis to ensure that the outer array is not null, while allowing inner elements to be null if necessary.\r\n\r\nString @NonNull [][] matrix;\r\n\r\n// ensures type system highlights that matrix = null.\r\n@NonNull String[][] matrix; \r\n\r\n// ensures both matrix and its elements are non-null. \r\n//Static analysis will flag any assignment of null to matrix or its elements.\r\n@NonNull String @NonNull [][] matrix; \r\n",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "ddacd26b-b42c-49ce-9e73-e51a8b6f2386",
      "cell_type": "code",
      "source": "@Target(ElementType.TYPE_PARAMETER)\r\n@interface TypeInfo {}\r\n\r\nclass Box<@TypeInfo T> {\r\n    T value;\r\n}",
