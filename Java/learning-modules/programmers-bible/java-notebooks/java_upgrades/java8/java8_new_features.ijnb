      "id": "f28045f8-2f1b-41f7-abdd-796ef6fd6ad1",
      "cell_type": "code",
      "source": "import java.util.*;\r\nimport java.util.stream.*;\r\n\r\n// ===================== Map new methods =====================\r\nSystem.out.println(\"===== Map Methods =====\");\r\n\r\nMap<String, Integer> map = new HashMap<>(Map.of(\"a\", 1, \"b\", 2, \"c\", 3));\r\n\r\nSystem.out.println(\"getOrDefault: \" + map.getOrDefault(\"z\", 99)); // 99\r\nmap.putIfAbsent(\"d\", 4);\r\nmap.putIfAbsent(\"a\", 999); // ignored, \"a\" already exists\r\nSystem.out.println(\"putIfAbsent: \" + map);\r\n\r\nmap.compute(\"a\", (k, v) -> v + 10); // a -> 11\r\nSystem.out.println(\"compute: \" + map);\r\n\r\nmap.computeIfAbsent(\"e\", k -> k.length()); // e -> 1\r\nSystem.out.println(\"computeIfAbsent: \" + map);\r\n\r\nmap.computeIfPresent(\"b\", (k, v) -> v * 100); // b -> 200\r\nSystem.out.println(\"computeIfPresent: \" + map);\r\n\r\nmap.merge(\"a\", 5, Integer::sum); // a -> 11+5 = 16\r\nSystem.out.println(\"merge: \" + map);\r\n\r\nmap.replaceAll((k, v) -> v + 1);\r\nSystem.out.println(\"replaceAll: \" + map);\r\n\r\nSystem.out.print(\"forEach: \");\r\nmap.forEach((k, v) -> System.out.print(k + \"=\" + v + \" \"));\r\nSystem.out.println();\r\n\r\n// ===================== List/Collection new methods =====================\r\nSystem.out.println(\"\\n===== List/Collection Methods =====\");\r\n\r\nList<String> items = new ArrayList<>(List.of(\"banana\", \"apple\", \"cherry\", \"avocado\", \"blueberry\"));\r\n\r\nSystem.out.print(\"forEach: \");\r\nitems.forEach(s -> System.out.print(s + \" \"));\r\nSystem.out.println();\r\n\r\nitems.removeIf(s -> s.startsWith(\"a\")); // removes apple, avocado\r\nSystem.out.println(\"removeIf (startsWith 'a'): \" + items);\r\n\r\nitems.replaceAll(String::toUpperCase);\r\nSystem.out.println(\"replaceAll toUpperCase: \" + items);\r\n\r\nitems.sort(Comparator.naturalOrder());\r\nSystem.out.println(\"sort: \" + items);\r\n\r\n// ===================== Comparator new methods =====================\r\nSystem.out.println(\"\\n===== Comparator Methods =====\");\r\n\r\nList<String> names = new ArrayList<>(List.of(\"Charlie\", \"Alice\", \"Bob\", \"Alice\"));\r\n\r\nnames.sort(Comparator.comparingInt(String::length).thenComparing(Comparator.naturalOrder()));\r\nSystem.out.println(\"comparing + thenComparing: \" + names);\r\n\r\nnames.sort(Comparator.comparingInt(String::length).reversed());\r\nSystem.out.println(\"reversed: \" + names);\r\n\r\nList<String> withNulls = new ArrayList<>(Arrays.asList(\"B\", null, \"A\", null, \"C\"));\r\nwithNulls.sort(Comparator.nullsFirst(Comparator.naturalOrder()));\r\nSystem.out.println(\"nullsFirst: \" + withNulls);\r\n\r\nwithNulls.sort(Comparator.nullsLast(Comparator.naturalOrder()));\r\nSystem.out.println(\"nullsLast: \" + withNulls);\r\n\r\n// ===================== Arrays new methods =====================\r\nSystem.out.println(\"\\n===== Arrays Methods =====\");\r\n\r\nint[] arr = {5, 3, 1, 4, 2};\r\n\r\nIntStream arrayStream = Arrays.stream(arr);\r\nSystem.out.println(\"stream sum: \" + arrayStream.sum());\r\n\r\nint[] toSort = {5, 3, 1, 4, 2};\r\nArrays.parallelSort(toSort);\r\nSystem.out.println(\"parallelSort: \" + Arrays.toString(toSort));\r\n\r\nint[] prefix = {1, 2, 3, 4, 5};\r\nArrays.parallelPrefix(prefix, Integer::sum); // running sum: [1, 3, 6, 10, 15]\r\nSystem.out.println(\"parallelPrefix (running sum): \" + Arrays.toString(prefix));\r\n\r\nint[] generated = new int[5];\r\nArrays.parallelSetAll(generated, i -> i * i); // [0, 1, 4, 9, 16]\r\nSystem.out.println(\"parallelSetAll (i²): \" + Arrays.toString(generated));\r\n\r\n// ===================== Math new methods =====================\r\nSystem.out.println(\"\\n===== Math Methods =====\");\r\n\r\nSystem.out.println(\"addExact: \" + Math.addExact(100, 200)); // 300\r\n// Math.addExact(Integer.MAX_VALUE, 1); // throws ArithmeticException\r\nSystem.out.println(\"floorDiv(7, 2): \" + Math.floorDiv(7, 2));     // 3\r\nSystem.out.println(\"floorDiv(-7, 2): \" + Math.floorDiv(-7, 2));   // -4 (vs -7/2 = -3)\r\nSystem.out.println(\"floorMod(-7, 2): \" + Math.floorMod(-7, 2));   // 1 (always non-negative for positive divisor)\r\nSystem.out.println(\"toIntExact(42L): \" + Math.toIntExact(42L));\r\n\r\n// ===================== Integer/Long/Double new methods =====================\r\nSystem.out.println(\"\\n===== Integer/Long/Double Methods =====\");\r\n\r\nSystem.out.println(\"Integer.sum(3, 4): \" + Integer.sum(3, 4));\r\nSystem.out.println(\"Integer.max(3, 4): \" + Integer.max(3, 4));\r\nSystem.out.println(\"Integer.min(3, 4): \" + Integer.min(3, 4));\r\nSystem.out.println(\"Long.compareUnsigned(-1, 1): \" + Long.compareUnsigned(-1L, 1L)); // positive, -1 as unsigned is large\r\nSystem.out.println(\"Double.isFinite(1.0): \" + Double.isFinite(1.0));\r\nSystem.out.println(\"Double.isFinite(Infinity): \" + Double.isFinite(Double.POSITIVE_INFINITY));\r\n\r\n// Practical use: Integer.sum as method reference in reduction\r\nList<Integer> nums = List.of(1, 2, 3, 4, 5);\r\nint total = nums.stream().reduce(0, Integer::sum);\r\nSystem.out.println(\"reduce with Integer::sum: \" + total); // 15",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "0d35e9c4-f1d2-48a1-9aac-a52a9dd4e908",
      "cell_type": "code",
      "source": "import java.util.*;\r\n\r\n// ===================== Optional API (Java 8) =====================\r\n\r\n// 1. Creating Optionals\r\nOptional<String> empty = Optional.empty();\r\nOptional<String> ofValue = Optional.of(\"Hello\");\r\nOptional<String> nullable = Optional.ofNullable(null);\r\nOptional<String> nullable2 = Optional.ofNullable(\"World\");\r\n\r\nSystem.out.println(\"empty: \" + empty);           // Optional.empty\r\nSystem.out.println(\"of: \" + ofValue);             // Optional[Hello]\r\nSystem.out.println(\"ofNullable(null): \" + nullable);   // Optional.empty\r\nSystem.out.println(\"ofNullable(val): \" + nullable2);   // Optional[World]\r\n\r\n// 2. isPresent / get\r\nSystem.out.println(\"\\nisPresent: \" + ofValue.isPresent()); // true\r\nSystem.out.println(\"isPresent (empty): \" + empty.isPresent()); // false\r\nSystem.out.println(\"get: \" + ofValue.get()); // Hello\r\n// empty.get(); // throws NoSuchElementException\r\n\r\n// 3. ifPresent — execute action if value exists\r\nofValue.ifPresent(v -> System.out.println(\"ifPresent: \" + v)); // ifPresent: Hello\r\nempty.ifPresent(v -> System.out.println(\"This won't print\"));\r\n\r\n// 4. orElse — return default if empty\r\nSystem.out.println(\"\\norElse: \" + empty.orElse(\"Default\")); // Default\r\nSystem.out.println(\"orElse (present): \" + ofValue.orElse(\"Default\")); // Hello\r\n\r\n// 5. orElseGet — lazy default via Supplier\r\nSystem.out.println(\"orElseGet: \" + empty.orElseGet(() -> \"Computed Default\"));\r\n\r\n// 6. orElseThrow — throw if empty\r\ntry {\r\n    empty.orElseThrow(() -> new IllegalStateException(\"No value!\"));\r\n} catch (IllegalStateException e) {\r\n    System.out.println(\"orElseThrow: \" + e.getMessage());\r\n}\r\n\r\n// 7. map — transform value if present\r\nOptional<Integer> length = ofValue.map(String::length);\r\nSystem.out.println(\"\\nmap (length): \" + length); // Optional[5]\r\nSystem.out.println(\"map on empty: \" + empty.map(String::length)); // Optional.empty\r\n\r\n// 8. flatMap — avoids Optional<Optional<T>>\r\nOptional<Optional<String>> nested = ofValue.map(s -> Optional.of(s.toUpperCase()));\r\nOptional<String> flat = ofValue.flatMap(s -> Optional.of(s.toUpperCase()));\r\nSystem.out.println(\"map (nested): \" + nested);     // Optional[Optional[HELLO]]\r\nSystem.out.println(\"flatMap (flat): \" + flat);      // Optional[HELLO]\r\nSystem.out.println(\"flatMap on empty: \" + empty.flatMap(s -> Optional.of(s.toUpperCase()))); // Optional.empty\r\n\r\n// 9. filter — keep value only if predicate matches\r\nSystem.out.println(\"\\nfilter (match): \" + ofValue.filter(s -> s.startsWith(\"H\"))); // Optional[Hello]\r\nSystem.out.println(\"filter (no match): \" + ofValue.filter(s -> s.startsWith(\"X\"))); // Optional.empty\r\nSystem.out.println(\"filter on empty: \" + empty.filter(s -> s.startsWith(\"H\"))); // Optional.empty\r\n\r\n// 10. Chaining operations — realistic example\r\nSystem.out.println(\"\\n===== Practical Examples =====\");\r\n\r\nMap<String, Map<String, String>> users = new HashMap<>();\r\nusers.put(\"user1\", Map.of(\"email\", \"user1@example.com\", \"name\", \"Alice\"));\r\nusers.put(\"user2\", Map.of(\"name\", \"Bob\"));\r\n\r\n// Safe nested lookup\r\nString email = Optional.ofNullable(users.get(\"user1\"))\r\n    .map(profile -> profile.get(\"email\"))\r\n    .map(String::toUpperCase)\r\n    .orElse(\"NO EMAIL\");\r\nSystem.out.println(\"User1 email: \" + email); // USER1@EXAMPLE.COM\r\n\r\nString missingEmail = Optional.ofNullable(users.get(\"user2\"))\r\n    .map(profile -> profile.get(\"email\"))\r\n    .orElse(\"NO EMAIL\");\r\nSystem.out.println(\"User2 email: \" + missingEmail); // NO EMAIL\r\n\r\nString unknownUser = Optional.ofNullable(users.get(\"user3\"))\r\n    .map(profile -> profile.get(\"email\"))\r\n    .orElse(\"NO EMAIL\");\r\nSystem.out.println(\"User3 email: \" + unknownUser); // NO EMAIL\r\n\r\n// 11. Optional with streams\r\nList<Optional<String>> optionals = List.of(\r\n    Optional.of(\"A\"), Optional.empty(), Optional.of(\"B\"), Optional.empty(), Optional.of(\"C\")\r\n);\r\n\r\n// Java 8 way to extract present values\r\nList<String> presentValues = optionals.stream()\r\n    .filter(Optional::isPresent)\r\n    .map(Optional::get)\r\n    .collect(Collectors.toList());\r\nSystem.out.println(\"\\nPresent values: \" + presentValues); // [A, B, C]\r\n\r\n// 12. OptionalInt, OptionalLong, OptionalDouble — primitive specializations\r\nOptionalInt optInt = OptionalInt.of(42);\r\nOptionalLong optLong = OptionalLong.empty();\r\nOptionalDouble optDouble = OptionalDouble.of(3.14);\r\n\r\nSystem.out.println(\"\\nOptionalInt: \" + optInt.getAsInt());           // 42\r\nSystem.out.println(\"OptionalLong present: \" + optLong.isPresent()); // false\r\nSystem.out.println(\"OptionalLong orElse: \" + optLong.orElse(0L));   // 0\r\nSystem.out.println(\"OptionalDouble: \" + optDouble.getAsDouble());   // 3.14",
      "metadata": {
        "language": "java"
      },
      "execution_count": null,
      "outputs": []
    }
  ]
